# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Game saves (personal data)
saves/*.json

# Don't ignore the saves directory itself
!saves/
!saves/.gitkeep

# Assets that users need to download themselves
# (fonts are usually copyrighted, sounds too)
# Uncomment these if you don't want to track assets:
# assets/fonts/*.ttf
# assets/sounds/*.wav
# assets/sounds/*.ogg
# assets/music/*.ogg

# Compiled/packaged versions
*.exe
*.app
*.dmg

# Logs
*.log

# Temporary files
*.tmp
*.bak
